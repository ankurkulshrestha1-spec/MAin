{
  "name": "pnbmet-fund-tracker-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "NAV ingestion + analytics API for PNB MetLife ULIP fund tracking",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "rm -f ./data/test.db* && DATABASE_PATH=./data/test.db node --test --import tsx test/*.test.ts",
    "scrape": "tsx src/scrape/run.ts",
    "seed": "tsx src/seed/run.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "cheerio": "^1.0.0",
    "dayjs": "^1.11.13",
    "dotenv": "^16.4.5",
    "fastify": "^5.1.0",
    "node-cron": "^3.0.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/node-cron": "^3.0.11",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=22.5.0"
  }
}
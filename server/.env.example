# HTTP port for the API
PORT=4000

# Where the SQLite file lives (relative paths resolve from server/)
DATABASE_PATH=./data/funds.db

# Source pages scraped for daily NAV. Override if PNB MetLife moves the page.
PNBMET_ALL_FUNDS_URL=https://www.pnbmetlife.com/investments/funds-performance/all-funds.html
PNBMET_NAV_URL=https://www.pnbmetlife.com/investments/track-fund-value.html

# Daily scrape schedule (cron, in the timezone below). ULIP NAVs publish after
# market close + valuation, so ~21:30 IST is a safe daily slot.
SCRAPE_CRON=30 21 * * 1-5
SCRAPE_TIMEZONE=Asia/Kolkata
SCRAPE_ON_BOOT=false

# Risk-free rate (annual, %) used for Sharpe. Roughly the 10Y G-Sec yield.
RISK_FREE_RATE=6.5

{
  "expo": {
    "name": "Fund Tracker",
    "slug": "pnbmet-fund-tracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "fundtracker",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#0B1220"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fundtracker.pnbmet"
    },
    "android": {
      "package": "com.fundtracker.pnbmet",
      "adaptiveIcon": { "backgroundColor": "#0B1220" }
    },
    "plugins": ["expo-router"]
  }
}
